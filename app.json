{
  "expo": {
    "name": "GameHubz",
    "scheme": "gamehubz",
    "slug": "gamehubz-mobile",
    "version": "2.18.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
   "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c9c58120-12eb-4992-910c-72661c654f7c"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "locales": {
      "en": "./native-locales/en.json",
      "es": "./native-locales/es.json",
      "pt-BR": "./native-locales/pt-BR.json",
      "pl": "./native-locales/pl.json",
      "sr-Latn": "./native-locales/sr-Latn.json",
      "ru": "./native-locales/ru.json",
      "uk": "./native-locales/uk.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.codespheresolutions.gamehubzmobile",
      "associatedDomains": [
        "applinks:share.codespheresolutions.dev"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "GameHubz requires access to your photo library so you can upload profile pictures for your account and hubs, as well as screenshots and short video clips as proof of match results. Selected photos and videos are used only within the app and are not shared with third parties.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.codespheresolutions.gamehubzmobile",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "share.codespheresolutions.dev",
              "pathPrefix": "/tournament"
            },
            {
              "scheme": "https",
              "host": "share.codespheresolutions.dev",
              "pathPrefix": "/hub"
            },
            {
              "scheme": "https",
              "host": "share.codespheresolutions.dev",
              "pathPrefix": "/user"
            },
            {
              "scheme": "https",
              "host": "share.codespheresolutions.dev",
              "pathPrefix": "/team"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c9c58120-12eb-4992-910c-72661c654f7c"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10B981"
        }
      ],
      "react-native-compressor",
      "expo-video"
    ]
  }
}
