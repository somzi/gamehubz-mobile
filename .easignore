# iskljucilo i native kod lokalnih modula (modules/*/android, modules/*/ios).
/android/
/ios/
/modules/*/android/build/
/modules/*/android/.gradle/
/modules/*/android/.cxx/
bin/
obj/

# Ignoriši logove i privremene fajlove
*.log
.npm/

# Lokalni web/export build
dist/
.ota-publish.lock
